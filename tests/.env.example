# Profile-specific serial ports.
# These names match sketch.yaml profile names uppercased by pytest-embedded.
TEST_SERIAL_PORT_S3_PEER_HOST=/dev/ttyUSB0
TEST_SERIAL_PORT_PEER_DEVICE_S3_PEER_DEVICE=/dev/ttyUSB1
TEST_SERIAL_PORT_ESP32S3=/dev/ttyACM0
TEST_SERIAL_PORT_ESP32P4=/dev/ttyACM1

# An ESP32-P4 pair wired OTG HS <-> OTG HS with an A-A cable. The host board runs
# the EspUsbHost sketch; the other is flashed by hand from
# tests/peer/usb_vendor_read/peer_device. Both variables below name the same host
# board -- they are separate because each resolves from its own profile name:
#   manual/vendor_bulk_in_throughput --profile p4_hs_direct
#   probe/p4_end_teardown
# They are kept apart from TEST_SERIAL_PORT_ESP32P4, which points at whichever
# single P4 is on the bench.
TEST_SERIAL_PORT_P4_HS_DIRECT=/dev/ttyACM2
TEST_SERIAL_PORT_P4_END_TEARDOWN=/dev/ttyACM2
# The device board of that pair. Not read by pytest; recorded so the hand-flash
# command has a name to use.
P4_HS_DIRECT_DEVICE_PORT=/dev/ttyACM3

# pytest options to generate an HTML report
#PYTEST_ADDOPTS="--html=report.html --self-contained-html"
